<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Internal Audit Dashboard</title>

@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.css

<style>

:root{
    --primary:#2563EB;
    --success:#22C55E;
    --warning:#F59E0B;
    --danger:#EF4444;
    --sidebar:#0F172A;
    --bg:#F1F5F9;
}

body{
    background:var(--bg);
    font-family:'Segoe UI',sans-serif;
    overflow-x:hidden;
}

/* Sidebar */

.sidebar{

    position:fixed;
    left:0;
    top:0;

    width:240px;
    height:100vh;

    background:var(--sidebar);
    color:white;

    padding-top:20px;
}

.logo{

    font-size:28px;
    font-weight:bold;

    text-align:center;

    margin-bottom:40px;
}

.menu-item{

    padding:15px 25px;
    cursor:pointer;

    transition:.3s;
}

.menu-item:hover{

    background:#1E293B;
}

.active-menu{

    background:var(--primary);
}

/* Main */

.main{

    margin-left:240px;
    padding:25px;
}

/* Header */

.header{

    display:flex;
    justify-content:space-between;
    align-items:center;

    margin-bottom:20px;
}

.header-title{

    font-size:28px;
    font-weight:700;
}

.header-sub{

    color:#64748B;
}

.profile{

    background:white;
    padding:10px 20px;
    border-radius:50px;

    box-shadow:0 2px 10px rgba(0,0,0,.06);
}

/* Card */

.dashboard-card{

    background:white;

    border-radius:20px;

    padding:20px;

    box-shadow:
    0 4px 20px rgba(0,0,0,.08);

    transition:.3s;
}

.dashboard-card:hover{

    transform:translateY(-3px);
}

.kpi{

    display:flex;
    align-items:center;
    gap:15px;
}

.kpi-icon{

    width:60px;
    height:60px;

    border-radius:50%;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:26px;
}

.bg-primary-soft{
    background:#DBEAFE;
}

.bg-success-soft{
    background:#DCFCE7;
}

.bg-warning-soft{
    background:#FEF3C7;
}

.bg-danger-soft{
    background:#FEE2E2;
}

.kpi h3{

    margin:0;
    font-size:30px;
    font-weight:bold;
}

/* Form */

.card-section{

    background:white;

    border-radius:20px;

    padding:25px;

    box-shadow:
    0 4px 20px rgba(0,0,0,.08);
}

/* Table */

.table{

    vertical-align:middle;
}

.table thead{

    background:#EFF6FF;
}

/* Badge */

.status-running{

    background:#DBEAFE;
    color:#1D4ED8;

    padding:5px 12px;
    border-radius:20px;
}

.status-done{

    background:#DCFCE7;
    color:#15803D;

    padding:5px 12px;
    border-radius:20px;
}

.status-overdue{

    background:#FEE2E2;
    color:#DC2626;

    padding:5px 12px;
    border-radius:20px;
}

/* Progress */

.progress{

    height:10px;
    border-radius:20px;
}

.progress-bar{

    background:linear-gradient(
            90deg,
            #2563EB,
            #60A5FA
    );
}

/* Gantt */

#gantt{

    min-height:500px;
    overflow:auto;
}

/* Chart */

.chart-card{

    background:white;

    border-radius:20px;

    padding:20px;

    box-shadow:
     0 4px 20px rgba(0,0,0,.08);
}

</style>

</head>

<body>

<div class="sidebar">

    <div class="logo">
        IA
    </div>

    <div class="menu-item active-menu">📊 Dashboard</div>
    <div class="menu-item">📋 專案管理</div>
    <div class="menu-item">✅ 缺失管理</div>
    <div class="menu-item">📅 甘特圖</div>
    <div class="menu-item">📈 統計報表</div>

</div>

<div class="main">

    <div class="header">

        <div>

            <div class="header-title">
                Internal Audit Dashboard
            </div>

            <div class="header-sub">
                稽核任務與進度管理系統
            </div>

        </div>

        <div class="profile">
            👤 Auditor Manager
        </div>

    </div>

    <!-- KPI -->

    <div class="row mb-4">

        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="kpi">
                    <div class="kpi-icon bg-primary-soft">📋</div>
                    <div>
                        <h3 id="totalProjects">0</h3>
                        <small>總專案數</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="kpi">
                    <div class="kpi-icon bg-warning-soft">⏳</div>
                    <div>
                        <h3 id="running">0</h3>
                        <small>執行中</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="kpi">
                    <div class="kpi-icon bg-success-soft">✅</div>
                    <div>
                        <h3 id="completed">0</h3>
                        <small>已完成</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="kpi">
                    <div class="kpi-icon bg-danger-soft">⚠️</div>
                    <div>
                        <h3 id="overdue">0</h3>
                        <small>逾期</small>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- 新增專案 -->

    <div class="card-section mb-4">

        <h5 class="mb-3">新增稽核專案</h5>

        <div class="row g-2">

            <div class="col-md-2">
                <input id="projectNo" class="form-control" placeholder="專案編號">
            </div>

            <div class="col-md-3">
                <input id="projectName" class="form-control" placeholder="專案名稱">
            </div>

            <div class="col-md-2">
                <input id="auditor" class="form-control" placeholder="稽核員">
            </div>

            <div class="col-md-2">
                <input id="startDate" type="date" class="form-control">
            </div>

            <div class="col-md-2">
                <input id="endDate" type="date" class="form-control">
            </div>

            <div class="col-md-1">
                <button class="btn btn-primary w-100">
                    新增
                </button>
            </div>

        </div>

    </div>

    <!-- Chart + Gantt -->

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="chart-card">

                <h5 class="mb-3">
                    專案狀態分析
                </h5>

                <canvas id="statusChart"></canvas>

            </div>

        </div>

        <div class="col-md-8">

            <div class="chart-card">

                <h5 class="mb-3">
                    年度稽核甘特圖
                </h5>

                <div id="gantt"></div>

            </div>

        </div>

    </div>

    <!-- Table -->

    <div class="card-section">

        <h5 class="mb-3">
            稽核專案清單
        </h5>

        <table class="table table-hover">

            <thead>

            <tr>
                <th>專案編號</th>
                <th>專案名稱</th>
                <th>稽核員</th>
                <th>進度</th>
                <th>狀態</th>
                <th>截止日</th>
            </tr>

            </thead>

            <tbody>

            <tr>

                <td>IA001</td>

                <td>資訊安全稽核</td>

                <td>David</td>

                <td width="250">

                    <div class="progress">
                        <div class="progress-bar"
                             style="width:70%">
                        </div>
                    </div>

                    <small>70%</small>

                </td>

                <td>
                    <span class="status-running">
                        進行中
                    </span>
                </td>

                <td>
                    2026-08-31
                </td>

            </tr>

            <tr>

                <td>IA002</td>

                <td>ERP權限稽核</td>

                <td>Amy</td>

                <td>

                    <div class="progress">
                        <div class="progress-bar"
                             style="width:100%">
                        </div>
                    </div>

                    <small>100%</small>

                </td>

                <td>
                    <span class="status-done">
                        已完成
                    </span>
                </td>

                <td>
                    2026-07-25
                </td>

            </tr>

            </tbody>

        </table>

    </div>

</div>

https://cdn.jsdelivr.net/npm/chart.js
https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.umd.js

<script>

new Chart(
document.getElementById("statusChart"),
{
type:"doughnut",

data:{
labels:["已完成","執行中","逾期"],
datasets:[{
data:[12,8,3],
backgroundColor:[
"#22C55E",
"#2563EB",
"#EF4444"
]
}]
}
});

const tasks = [
{
id:"1",
name:"資訊安全稽核",
start:"2026-08-01",
end:"2026-08-31",
progress:70
},
{
id:"2",
name:"ERP權限稽核",
start:"2026-07-01",
end:"2026-07-25",
progress:100
}
];

new Gantt("#gantt",tasks);

</script>

</body>
</html>
